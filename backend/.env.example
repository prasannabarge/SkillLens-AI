# SkillLens AI - Environment Configuration Template
# Copy this file to .env and configure values locally.
# Never commit real credentials or secrets.

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
HOST=localhost

# ============================================
# MONGODB
# ============================================
# Replace with your local MongoDB or Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/skilllens
DB_NAME=skilllens

# ============================================
# AUTHENTICATION
# ============================================
# Generate a unique, cryptographically secure secret locally.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES=10

# ============================================
# NLP MICROSERVICE
# ============================================
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TIMEOUT=30000

# Add this only after implementing service authentication
# in both the Node.js backend and FastAPI service.
NLP_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_INTERNAL_SERVICE_TOKEN

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

# ============================================
# EMAIL (OPTIONAL)
# ============================================
# Configure only if email functionality is implemented.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=